# App's Bitcoin network: regtest or signet
VITE_BTC_NETWORK=signet
# Recovery delay D, in blocks (demo: 6; presented target value: ~26000)
VITE_RECOVERY_DELAY=6
# Signet Esplora API (mempool.space is unreachable from some networks)
VITE_ESPLORA_URL=https://blockstream.info/signet/api
VITE_EXPLORER_URL=https://blockstream.info/signet
# Local regtest bitcoind (Docker). Test credentials of the local container, worthless.
BTC_RPC_URL=http://regtest:regtest@127.0.0.1:18443
# bank-mock (mocked Swissquote backend, separate process)
BANK_MOCK_PORT=4000
VITE_BANK_MOCK_URL=http://localhost:4000
# "Attacks" panel server (regtest demo)
ATTACKS_PORT=4200
VITE_ATTACKS_URL=http://localhost:4200
# Client Wallet (reference implementation, separate app)
CLIENT_WALLET_PORT=5180
VITE_CLIENT_WALLET_URL=http://localhost:5180
VITE_WALLET_ALLOWED_ORIGINS=http://localhost:5173
VITE_GUARDIAN_CONSOLE_URL=http://localhost:5174
# Simulated BTC/CHF rate (display)
VITE_BTC_CHF=85000
# Interfaces d'écoute (boucle locale par défaut ; ne pas exposer sur le réseau local)
CLIENT_WALLET_HOST=localhost
BANK_MOCK_HOST=localhost
ATTACKS_HOST=localhost
# Origines autorisées par bank-mock (CORS et WebAuthn)
BANK_MOCK_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Verrou de la partie crypto (passkey exigée) : « off » réservé aux anciens tests automatisés
BANK_MOCK_CRYPTO_LOCK=on
# Garde-fous de bank-mock : frais maximum d'une recovery (% du montant), échecs de re-KYC avant blocage de 15 min
BANK_MOCK_MAX_RECOVERY_FEE_PCT=5
BANK_MOCK_KYC_MAX_FAILS=5
# Montant élevé (sats) : step-up passkey dans l'appli, confirmation renforcée dans le Client Wallet
VITE_HIGH_VALUE_SATS=20000000
CLIENT_WALLET_HIGH_VALUE_SATS=20000000
# Ethereum (Sepolia) : nœud public, bundler et paymaster publics de Candide (sans clé), module de recovery (3 min)
VITE_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_EVM_BUNDLER_URL=https://api.candide.dev/public/v3/11155111
VITE_EVM_RECOVERY_MODULE=0x949d01d424bE050D09C16025dd007CB59b3A8c66
