# App's Bitcoin network: regtest or signet
VITE_BTC_NETWORK=signet
# Recovery delay D, in blocks (demo: 6; presented target value: ~26000)
VITE_RECOVERY_DELAY=6
# Signet Esplora API (mempool.space is unreachable from some networks)
VITE_ESPLORA_URL=https://blockstream.info/signet/api
VITE_EXPLORER_URL=https://blockstream.info/signet
# Local regtest bitcoind (Docker). Test credentials of the local container, worthless.
BTC_RPC_URL=http://regtest:regtest@127.0.0.1:18443
# bank-mock (mocked Swissquote backend, separate process)
BANK_MOCK_PORT=4000
VITE_BANK_MOCK_URL=http://localhost:4000
# "Attacks" panel server (regtest demo)
ATTACKS_PORT=4200
VITE_ATTACKS_URL=http://localhost:4200
# Client Wallet (reference implementation, separate app)
CLIENT_WALLET_PORT=5180
VITE_CLIENT_WALLET_URL=http://localhost:5180
VITE_WALLET_ALLOWED_ORIGINS=http://localhost:5173
VITE_GUARDIAN_CONSOLE_URL=http://localhost:5174
# Simulated BTC/CHF rate (display)
VITE_BTC_CHF=85000
