# Réseau Bitcoin de l'appli : regtest ou signet
VITE_BTC_NETWORK=signet
# Délai de recovery D, en blocs (démo : 6 ; valeur cible présentée : ~26000)
VITE_RECOVERY_DELAY=6
# API Esplora signet (mempool.space est injoignable depuis certains réseaux)
VITE_ESPLORA_URL=https://blockstream.info/signet/api
VITE_EXPLORER_URL=https://blockstream.info/signet
# bitcoind regtest local (Docker). Identifiants de test du conteneur local, sans valeur.
BTC_RPC_URL=http://regtest:regtest@127.0.0.1:18443
# bank-mock (backend Swissquote mocké, processus séparé)
BANK_MOCK_PORT=4000
VITE_BANK_MOCK_URL=http://localhost:4000
# Session de la banque simulée : identifiant du client connecté (dossiers de test dans bank-mock/src/kyc.ts)
VITE_CUSTOMER_ID=CH-0001
