{
  "name": "swissquote-wallet",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "client",
    "tools/*",
    "bank-mock",
    "guardian-console",
    "client-wallet"
  ],
  "scripts": {
    "dev": "concurrently -n client,bank,console -c blue,red,green \"npm run dev -w client\" \"npm run dev -w bank-mock\" \"npm run dev -w guardian-console\"",
    "build": "npm run build -w client",
    "keygen": "npm run -s keygen -w tools/keygen --",
    "client-signer": "npm run -s sign -w tools/client-signer --",
    "regtest:up": "docker compose -f docker/regtest.yml up -d",
    "regtest:down": "docker compose -f docker/regtest.yml down -v",
    "validate:1": "tsx scripts/validate/etape-1-regtest.ts",
    "typecheck": "tsc -p packages/bitcoin && tsc -p tools/client-signer && tsc -p tools/keygen && tsc -p client && tsc -p bank-mock && tsc -p guardian-console && tsc -p client-wallet",
    "validate:1:signet": "tsx scripts/validate/etape-1-signet.ts",
    "validate:2": "tsx scripts/validate/etape-2.ts",
    "validate:3": "tsx scripts/validate/etape-3.ts",
    "validate:3:signet": "tsx scripts/validate/etape-3-signet.ts",
    "test:attacks": "tsx scripts/attacks/run.ts",
    "attacks:server": "tsx scripts/attacks/server.ts",
    "validate:inv5": "tsx scripts/validate/invariant-5.ts",
    "demo": "concurrently -n appli,bank,console,wallet,attaques -c blue,red,green,yellow,magenta \"VITE_BTC_NETWORK=regtest npm run dev -w client\" \"npm run dev -w bank-mock\" \"VITE_BTC_NETWORK=regtest npm run dev -w guardian-console\" \"npm run dev -w client-wallet\" \"npm run attacks:server\"",
    "regtest": "tsx scripts/demo/regtest.ts",
    "validate:6:ui": "tsx scripts/validate/etape-6-ui.ts",
    "validate:7": "tsx scripts/validate/etape-7.ts",
    "demo:signet": "concurrently -n appli,bank,console,wallet -c blue,red,green,yellow \"VITE_BTC_NETWORK=signet npm run dev -w client\" \"npm run dev -w bank-mock\" \"VITE_BTC_NETWORK=signet npm run dev -w guardian-console\" \"npm run dev -w client-wallet\"",
    "validate:8:signet": "tsx scripts/validate/etape-8-signet-ui.ts",
    "validate:17": "tsx scripts/validate/etape-17-evm-ui.ts",
    "validate:18": "tsx scripts/validate/etape-18-evm-recovery-ui.ts",
    "validate:19": "tsx scripts/validate/etape-19-captures.ts",
    "validate:20": "tsx scripts/validate/etape-20-market-ui.ts",
    "validate:21": "tsx scripts/validate/etape-21-esplora-cache.ts",
    "validate:22": "tsx scripts/validate/etape-22-public-ui.ts",
    "demo:signet:ports": "./scripts/demo/signet-ports.sh",
    "validate:8:pin": "tsx scripts/validate/etape-8-pin.ts",
    "validate:8:alerts": "tsx scripts/validate/etape-8-alerts.ts",
    "validate:9": "tsx scripts/validate/etape-9.ts",
    "validate:9:budget": "tsx scripts/validate/esplora-budget.ts",
    "validate:10": "tsx scripts/validate/etape-10-auth.ts",
    "validate:11": "tsx scripts/validate/etape-11-transfers.ts",
    "validate:12": "tsx scripts/validate/etape-12-relay.ts",
    "validate:37": "tsx scripts/validate/etape-37-bio.ts",
    "validate:38": "tsx scripts/validate/etape-38-crypto-lock.ts",
    "validate:40": "tsx scripts/validate/etape-40-device-wallets.ts",
    "validate:41": "tsx scripts/validate/etape-41-exit-kit.ts",
    "validate:42": "tsx scripts/validate/etape-42-bio-migration-ui.ts",
    "validate:43": "tsx scripts/validate/etape-43-change-contact.ts",
    "validate:44": "tsx scripts/validate/etape-44-prf.ts",
    "validate:46": "tsx scripts/validate/etape-46-network.ts"
  },
  "devDependencies": {
    "bip322-js": "^4.0.0",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
